# Databricks — one workspace carries the warehouse, the gold tables, the Genie
# space and the Multi-Agent Supervisor.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
DATABRICKS_WAREHOUSE_ID=...

# Telegram Bot (connect the bot to Databricks Genie)
TELEGRAM_BOT_TOKEN=

# OpenAI (used by the chat endpoint for intent parsing + answer generation)
OPEN_AI_API_KEY=

# Catalog holding the gold tables. MUST match the catalog the Genie space
# queries, or the ask panel answers about a different dataset than every other
# screen — with nothing on screen to reveal it.
DATABRICKS_CATALOG=databricks_hackthon.default

# Genie space. Set BOTH: the older client reads GENIE_SPACE_ID, the newer one
# reads DATABRICKS_GENIE_SPACE_ID. Setting one leaves the other silently
# unavailable, which surfaces as a null answer rather than an error.
GENIE_SPACE_ID=...
DATABRICKS_GENIE_SPACE_ID=...

# Multi-Agent Supervisor endpoint (agent/v1/responses task).
DATABRICKS_AGENT_ENDPOINT=https://<workspace>.cloud.databricks.com/serving-endpoints/<name>/invocations
DATABRICKS_AGENT_TOKEN=dapi...

# Student archive: local SQLite + embeddings from the corpus pipeline.
# Not in the repo (too large) — point at wherever the pipeline output lives.
DERIVED_DATA_DIR=./DERIVED_DATA

# Optional
# PAPERS_ROOT=
# CORS_ORIGINS=
