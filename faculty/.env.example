# Databricks — the faculty console reads the same tables Genie is configured against.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
DATABRICKS_WAREHOUSE_ID=...
DATABRICKS_GENIE_SPACE_ID=...
# Catalog holding the gold tables. MUST match the Genie space's catalog, or
# /ask answers from a different dataset than every other screen.
DATABRICKS_CATALOG=hackathon_project.default
